@page "/auth"
@rendermode InteractiveServer
@inject AppSettings AppSettings

<div>
	@authPageContent
</div>

@code {

	private string authPageContent;

	protected override async Task OnInitializedAsync()
	{
		var oauthClient = new WhoopOAuthClient(AppSettings.Auth.ClientId, AppSettings.Auth.ClientSecret);

		var state = Guid.NewGuid().ToString();

		var authUrl = oauthClient.BuildAuthorizationUrl("http://localhost:5179/oauth/redirect", Scopes.AllScopes, state);

		var httpClient = new HttpClient();

		HttpResponseMessage authResult = await httpClient.GetAsync(authUrl);

		authPageContent = await authResult.Content.ReadAsStringAsync();
	}
}
